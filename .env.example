# =============================================================================
# AI Job Agent Platform - Environment Configuration Template
# Region: Germany / EU (AWS Frankfurt eu-central-1)
# =============================================================================

# Database (PostgreSQL + pgvector)
POSTGRES_USER=jobagent_user
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_DB=jobagent_db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend API (.NET 10)
ASPNETCORE_ENVIRONMENT=Development
PORT=5000
JWT_SECRET=ReplaceWithAStrongSecretKeyAtLeast32BytesLengthForSecurity2026!
JWT_ISSUER=JobAgentPlatform
JWT_AUDIENCE=JobAgentClients
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# AI & NLP Service (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Storage (AWS S3 Frankfurt / MinIO)
AWS_REGION=eu-central-1
AWS_S3_BUCKET_NAME=jobagent-resumes-frankfurt
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_AI_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
